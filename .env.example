# Variables para docker compose. Copia este archivo como .env (en esta misma carpeta)
# y completa los valores. El .env nunca se sube a Git. Aquí no va ningún valor real.
#
# Las tres primeras son las mismas de backend/.env: puedes copiar los valores de allí.

# Usuario y contraseña con los que se crea la base de datos del contenedor.
DB_USUARIO=
DB_CONTRASENA=

# Mínimo 64 caracteres.
JWT_CLAVE_SECRETA=

# API de mapas. Sin clave de Google se usa Nominatim (OpenStreetMap), que no pide clave.
GOOGLE_MAPS_API_KEY=
# auto | google | nominatim
GEO_PROVEEDOR=auto
# Correo de contacto que Nominatim recomienda enviar (opcional).
NOMINATIM_CORREO_CONTACTO=

# Nivel de los logs del backend (INFO, DEBUG, WARN…).
NIVEL_LOGS=INFO

# Comentarios y reportes (opcionales).
COMENTARIO_LARGO_MAXIMO=1000
REPORTE_LARGO_DESCRIPCION=1000

# Almacén de las fotos (obligatorio): el servicio «s3» de Docker (SeaweedFS) y el backend usan
# las mismas claves. Pon valores largos y al azar, por ejemplo con: openssl rand -hex 20
S3_CLAVE_ACCESO=cambia-esta-clave-de-acceso
S3_CLAVE_SECRETA=cambia-esta-clave-secreta-larga-y-al-azar
S3_BUCKET=aldia-imagenes

# Límites de las fotos (opcionales).
IMAGENES_MAXIMO_POR_NOTICIA=4
IMAGENES_TAMANO_MAXIMO_MB=5
IMAGENES_TAMANO_MAXIMO_PETICION_MB=25
