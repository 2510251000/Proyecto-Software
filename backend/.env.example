# Copia este archivo como .env (en esta carpeta, backend/) y completa los valores.
# El .env nunca se sube a Git. Aquí no va ningún valor real.

# ---- Obligatorias en todos los perfiles ----
DB_USUARIO=
DB_CONTRASENA=
# Mínimo 64 caracteres
JWT_CLAVE_SECRETA=

# ---- API de mapas (geocodificación) ----
# auto: usa Google Maps si GOOGLE_MAPS_API_KEY tiene valor; si no, Nominatim (OpenStreetMap, gratis y sin clave).
# google | nominatim: fuerza uno de los dos.
# GEO_PROVEEDOR=auto
# Clave de la Geocoding API de Google Maps. Solo vive en el backend; nunca en Angular.
GOOGLE_MAPS_API_KEY=
# Correo de contacto que Nominatim recomienda enviar (opcional).
# NOMINATIM_CORREO_CONTACTO=
# GEO_IDIOMA=es
# GEO_PAISES=co
# GEO_TIEMPO_ESPERA_MS=8000
# GEO_MAXIMO_RESULTADOS=5
# GOOGLE_MAPS_URL=https://maps.googleapis.com/maps/api/geocode/json
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# NOMINATIM_AGENTE=AlDia-PortalNoticias/1.0 (proyecto academico Universidad de Cundinamarca)
# NOMINATIM_INTERVALO_MS=1100

# ---- Opcionales en dev (tienen valor predeterminado), obligatorias en test y prod ----
# Quita el "#" solo si vas a cambiar el valor. Una variable vacía NO usa el predeterminado.
# PERFIL_ACTIVO=dev
# DB_URL=jdbc:postgresql://localhost:5432/aldia_db
# JWT_EXPIRACION_MS=86400000
# CORS_ORIGENES=http://localhost:4200
# PUERTO=8080

# ---- Reglas del negocio (opcionales; ver docs/DECISIONES.md) ----
# ZONA_HORARIA=America/Bogota
# NIVEL_PUNTOS_PUBLICACION=10
# NIVEL_PUNTOS_PENALIZACION=20
# RECOMENDACION_HORAS_POR_NIVEL=12
# RECOMENDACION_HORAS_OFICIAL=6
# ADMIN_SIN_LIMITE_DIARIO=true
# NOTICIAS_MAXIMO_LISTADO=200
# NOTIFICACIONES_MAXIMO_LISTADO=50

# ---- Comentarios y reportes (opcionales) ----
# COMENTARIO_LARGO_MAXIMO=1000
# REPORTE_LARGO_DESCRIPCION=1000
# COMENTARIOS_MAXIMO_LISTADO=200
# REPORTES_MAXIMO_LISTADO=200

# ---- Fotos de las noticias (opcionales) ----
# Carpeta donde se guardan (relativa a backend/ si arrancas desde ahí).
# IMAGENES_DIRECTORIO=imagenes
# IMAGENES_MAXIMO_POR_NOTICIA=4
# IMAGENES_TAMANO_MAXIMO_MB=5
# IMAGENES_TAMANO_MAXIMO_PETICION_MB=25
# IMAGENES_ANCHO_MAXIMO=8000
# IMAGENES_ALTO_MAXIMO=8000
# IMAGENES_LARGO_DESCRIPCION=250
# IMAGENES_CALIDAD_JPEG=0.9
# IMAGENES_CACHE_SEGUNDOS=86400

# ---- Base de datos ----
# Migraciones de Flyway. En dev se agregan los datos de demostración (classpath:db/demo).
# FLYWAY_UBICACIONES=classpath:db/migration,classpath:db/demo
# MOSTRAR_SQL=false
