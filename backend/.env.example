# Copia este archivo como .env y completa los valores. El .env nunca se sube a Git.

# ---- Obligatorias en todos los perfiles ----
DB_USUARIO=
DB_CONTRASENA=
# Minimo 64 caracteres
JWT_CLAVE_SECRETA=

# ---- Opcionales en dev (tienen valor predeterminado), obligatorias en test y prod ----
# Quita el "#" solo si vas a cambiar el valor. Una variable vacia NO usa el predeterminado.
# PERFIL_ACTIVO=dev
# DB_URL=jdbc:postgresql://localhost:5432/aldia_db
# JWT_EXPIRACION_MS=86400000
# CORS_ORIGENES=http://localhost:4200
# PUERTO=8080
# ZONA_HORARIA=America/Bogota
